{
	"name": "@badgered/monorepo",
	"description": "A badge creator for the web.",
	"version": "3.0.0",
	"private": true,
	"scripts": {
		"frontend:dev": "cd frontend && pnpm dev",
		"frontend:build": "cd frontend && pnpm build",
		"api:dev": "cd api && pnpm dev",
		"api:build": "cd api && pnpm build",
		"dev": "concurrently \"pnpm api:dev\" \"pnpm frontend:dev\" ",
		"build": "concurrently \"pnpm frontend:build\" \"pnpm api:build\""
	},
	"keywords": [],
	"author": "WorldWidePixel",
	"license": "MPL-2.0",
	"devDependencies": {
		"concurrently": "^9.2.1",
		"prettier": "^3.8.2"
	}
}
