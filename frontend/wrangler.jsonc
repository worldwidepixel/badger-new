{
	"name": "badger",
	"compatibility_date": "2026-05-18",
	"observability": {
		"enabled": true
	},
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"NODE_VERSION": "24.15.0"
	}
}
